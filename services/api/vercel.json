{
  "version": 2,
  "builds": [
    {
      "src": "dist/services/api/src/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "dist/services/api/src/index.js"
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "env": {
    "NODE_ENV": "production"
  },
  "regions": ["bom1"],
  "github": {
    "enabled": true,
    "autoAlias": false
  }
}
