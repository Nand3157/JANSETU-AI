rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Citizen evidence photos — upload hardening at the rules layer (#20)
    match /citizen-media/{userId}/{fileName} {
      // Only the owner may write into their own folder, images only, ≤5MB
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size <= 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp)');
      // Photos may contain PII — authenticated reads only; analysts see via backend when needed
      allow read: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    match /{allPaths=**} { allow read, write: if false; } // deny-by-default
  }
}
