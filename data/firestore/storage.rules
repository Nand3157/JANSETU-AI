rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Citizen evidence — photos + voice clips — upload hardening at the rules layer (#20) — C-08 fix
    match /citizen-media/{userId}/{fileName} {
      // Only the owner may write into their own folder, images or audio, ≤8MB (transcribe 8MB, upload 5MB, max 8MB)
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size <= 8 * 1024 * 1024
                   && (request.resource.contentType.matches('image/(jpeg|png|webp)') || request.resource.contentType.matches('audio/.*'));
      // Media may contain PII — authenticated reads only; analysts see via backend when needed
      allow read: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    match /{allPaths=**} { allow read, write: if false; } // deny-by-default
  }
}
