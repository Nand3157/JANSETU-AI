# ============================================================================
# JANSETU AI — Environment Variables
# Copy the WEB block into apps/web/.env.local
# Copy the API block into services/api/.env  (never commit either file)
# Full setup walkthrough: docs/FIREBASE_SETUP.md
# ============================================================================

# ── WEB (apps/web/.env.local) ────────────────────────────────────────────────

# Express API base URL (proxies ALL secret-key calls; browser never holds them)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Firebase WEB config — Firebase Console → Project settings → General → Your apps → Web app → Config
# Paste as ONE line of minified JSON. Safe to expose: protected by Security Rules + App Check,
# NOT a secret (identifies, does not authorize).
# Example: {"apiKey":"AIza...","authDomain":"jansetu-ai.firebaseapp.com","projectId":"jansetu-ai","storageBucket":"jansetu-ai.appspot.com","messagingSenderId":"1234567890","appId":"1:1234:web:abcd"}
NEXT_PUBLIC_FIREBASE_CONFIG=

# Google Maps JavaScript API key — RESTRICT to your domains (HTTP referrers) in Google Cloud Console.
# Browser keys are public by design; restrictions + billing caps are the protection.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# ── API (services/api/.env) ── SERVER-ONLY, NEVER prefix with NEXT_PUBLIC ────

PORT=8080
NODE_ENV=development            # production disables demo auth + error details

# Gemini (prompt processing) — Google AI Studio key. SERVER-SIDE ONLY (#2).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_DAILY_CAP=500            # hard spend ceiling: AI calls per UTC day
GEMINI_MAX_OUTPUT_TOKENS=4096

# Firebase Admin — EITHER paste the full service-account JSON on one line…
FIREBASE_SERVICE_ACCOUNT_JSON=
# …OR point to the downloaded key file instead:
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=

# Supabase Storage (photo uploads) — supabase.com → Project Settings → API.
# Free tier, no card. Server-side only — NEVER expose the service-role key to the browser (#2).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=citizen-media
SUPABASE_SIGNED_READ_SECONDS=604800

# Auth strictness — false in production: unsigned requests get 401 (#4,#5)
ALLOW_DEMO_AUTH=true            # dev only!

# CORS whitelist (#13) — exact origins allowed to call this API, comma-separated
CORS_ORIGINS=http://localhost:3000

# Rate limits / body caps (#6)
RATE_MAX_GENERAL=300            # requests per IP per window on /api/*
RATE_MAX_AI=30                  # AI-heavy routes (/analyze, /copilot)
RATE_WINDOW_MS=900000           # window = 15 min
MAX_BODY_BYTES=100kb
MAX_UPLOAD_BYTES=5242880        # 5 MB photo cap

# Ops
SHOW_ERRORS=false               # true ONLY while debugging locally
SKIP_SEED=false                 # true when Firestore is seeded by data/firestore/seed.js
